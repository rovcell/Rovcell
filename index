    function calculateGaransiExpiry(diambilDateStr, garansiType) {
      if (!diambilDateStr || garansiType === 'Tidak ada') return null;
      let parts = diambilDateStr.split('-');
      if (parts.length !== 3) return null;
      let dateObj = new Date(parts[0], parts[1] - 1, parts[2]);

      if (garansiType.includes('minggu')) {
        let weeks = parseInt(garansiType) || 1;
        dateObj.setDate(dateObj.getDate() + (weeks * 7));
      } else if (garansiType.includes('bulan')) {
        let months = parseInt(garansiType) || 1;
        dateObj.setMonth(dateObj.getMonth() + months);
      } else if (garansiType.includes('tahun')) {
        let years = parseInt(garansiType) || 1;
        dateObj.setFullYear(dateObj.getFullYear() + years);
      }

      let d = String(dateObj.getDate()).padStart(2, '0');
      let m = String(dateObj.getMonth() + 1).padStart(2, '0');
      let y = dateObj.getFullYear();
      return `${d}-${m}-${y}`;
    }

    function isGaransiActive(diambilDateStr, garansiType) {
      if (!diambilDateStr || garansiType === 'Tidak ada') return false;
      let parts = diambilDateStr.split('-');
      if (parts.length !== 3) return false;
      let startObj = new Date(parts[0], parts[1] - 1, parts[2]);
      let expiryObj = new Date(startObj);

      if (garansiType.includes('minggu')) {
        let weeks = parseInt(garansiType) || 1;
        expiryObj.setDate(expiryObj.getDate() + (weeks * 7));
      } else if (garansiType.includes('bulan')) {
        let months = parseInt(garansiType) || 1;
        expiryObj.setMonth(expiryObj.getMonth() + months);
      } else if (garansiType.includes('tahun')) {
        let years = parseInt(garansiType) || 1;
        expiryObj.setFullYear(expiryObj.getFullYear() + years);
      }

      let now = new Date();
      return now >= startObj && now <= expiryObj;
    }

