<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rovcell Smartphone - Cek Status & Service Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            neon: {
              blue: '#00f3ff',
              dark: '#050b14',
              card: '#0a192f',
              border: '#1e3a8a',
              glow: 'rgba(0, 243, 255, 0.3)'
            }
          },
          fontFamily: {
            orbitron: ['Orbitron', 'sans-serif'],
            sans: ['Plus Jakarta Sans', 'sans-serif']
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #050b14;
      color: #e2e8f0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-image:
        radial-gradient(circle at 10% 20%, rgba(0, 243, 255, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(0, 102, 255, 0.05) 0%, transparent 40%);
    }
    .neon-glow {
      box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);
      border: 1px solid rgba(0, 243, 255, 0.3);
    }
    .circuit-bg {
      background-image: linear-gradient(rgba(5, 11, 20, 0.9), rgba(5, 11, 20, 0.9)),
        url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2300f3ff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4H-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }

    /* Cetak Nota Thermal 1 Halaman Terisolasi & Font Tebal */
    #printReceiptArea {
      display: none;
    }
    @media print {
      @page {
        margin: 0mm;
      }
      html, body {
        background: #ffffff !important;
        background-image: none !important;
        color: #000000 !important;
        margin: 0 !important;
        padding: 0 !important;
        height: auto !important;
        min-height: 0 !important;
        overflow: visible !important;
      }
      body > *:not(#printReceiptArea) {
        display: none !important;
      }
      #printReceiptArea {
        display: block !important;
        background: #ffffff !important;
        color: #000000 !important;
        margin: 0 !important;
        padding: 2mm 3mm !important;
        font-family: 'Courier New', Courier, monospace !important;
        font-weight: 900 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      #printReceiptArea * {
        color: #000000 !important;
        font-weight: 900 !important;
        border-color: #000000 !important;
      }
    }
  </style>
  <link rel="manifest" href="./manifest.json">
  <meta name="theme-color" content="#00f3ff">
  <link rel="apple-touch-icon" href="./icon-192.png">
</head>

<body class="circuit-bg min-h-screen flex flex-col justify-between">

  <!-- Header Toko -->
  <header class="border-b border-neon-border bg-neon-dark/80 backdrop-blur-md sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col items-center justify-center text-center gap-3">
      <div class="flex flex-col items-center space-y-1.5 cursor-pointer" onclick="switchTab('home')">
        <div>
          <h1 class="font-orbitron font-bold text-xl tracking-wider text-white">ROVCELL</h1>
          <p class="text-xs text-neon-blue tracking-widest uppercase">Smartphone Service</p>
          <p class="text-[11px] text-slate-400 mt-1 flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-location-dot text-neon-blue"></i> Jl. Maluku No. 7 Karangtengah Sananwetan Kota Blitar
          </p>
        </div>
      </div>
      <div class="flex items-center space-x-3 pt-1">
        <button type="button" onclick="switchTab('home')" class="px-4 py-2 text-sm font-medium rounded-lg transition text-slate-300 hover:text-neon-blue hover:bg-neon-blue/10 cursor-pointer">
          <i class="fa-solid fa-magnifying-glass mr-2"></i>Cek Status
        </button>
        <button type="button" onclick="checkAdminAccess()" class="px-4 py-2 text-sm font-semibold rounded-lg bg-neon-blue/10 border border-neon-blue text-neon-blue neon-glow hover:bg-neon-blue hover:text-neon-dark transition cursor-pointer">
          <i class="fa-solid fa-lock mr-2"></i>Admin Dashboard
        </button>
      </div>
    </div>
  </header>

  <!-- Konten Utama -->
  <main class="max-w-7xl mx-auto px-4 py-8 flex-grow w-full">

    <!-- SECTION: HOME / CEK STATUS -->
    <section id="tab-home" class="max-w-xl mx-auto space-y-8">
      <div class="text-center space-y-3">
        <h2 class="font-orbitron text-3xl font-bold text-white">Lacak Status Service HP</h2>
        <p class="text-slate-400 text-sm">Masukkan nomor nota dan PIN 3 digit nomor HP Anda untuk melihat progres perbaikan.</p>
      </div>

      <div class="bg-neon-card p-6 rounded-2xl neon-glow border border-neon-border space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="space-y-2 sm:col-span-2">
            <div class="flex justify-between items-center">
              <label class="block text-sm font-medium text-neon-blue">Nomor Nota Service</label>
              <button type="button" onclick="openLupaNotaModal()" class="text-xs text-neon-blue hover:underline font-medium cursor-pointer">
                <i class="fa-solid fa-circle-question mr-1"></i>Minta Nomor Nota
              </button>
            </div>
            <div class="relative w-full flex items-center">
              <span class="absolute left-4 text-neon-blue font-bold font-orbitron text-sm">ROV-</span>
              <input type="text" id="searchNotaInput" placeholder="0001" class="w-full bg-neon-dark border border-neon-border rounded-xl pl-16 pr-4 py-3 text-white placeholder-slate-600 focus:outline-none focus:border-neon-blue uppercase">
            </div>
          </div>
          <div class="space-y-2">
            <label class="block text-sm font-medium text-neon-blue">3 Digit Terakhir No. WA</label>
            <input type="text" id="searchPhonePin" maxlength="3" placeholder="Cth: 876" class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-3 text-white placeholder-slate-600 focus:outline-none focus:border-neon-blue text-center tracking-widest font-bold">
          </div>
        </div>

        <button type="button" onclick="searchService()" class="w-full bg-neon-blue text-neon-dark font-bold py-3 rounded-xl hover:bg-cyan-400 transition shadow-lg shadow-cyan-500/20 flex items-center justify-center gap-2 cursor-pointer">
          <i class="fa-solid fa-search"></i> Cek Status Service
        </button>

        <!-- Riwayat Pengecekan Cepat -->
        <div id="recentSearchesContainer" class="hidden pt-3 border-t border-slate-800 space-y-2">
          <div class="flex justify-between items-center text-[11px] text-slate-400">
            <span><i class="fa-solid fa-clock-rotate-left mr-1.5 text-neon-blue"></i>Riwayat Pengecekan Terakhir:</span>
            <button type="button" onclick="clearRecentSearches()" class="text-slate-500 hover:text-red-400 text-[10px] underline cursor-pointer">Hapus Riwayat</button>
          </div>
          <div id="recentChipsList" class="flex flex-wrap gap-2"></div>
        </div>
      </div>

      <div id="searchResultContainer" class="hidden space-y-4"></div>
    </section>

    <!-- SECTION: ADMIN LOGIN -->
    <section id="tab-login" class="max-w-md mx-auto hidden">
      <div class="bg-neon-card p-8 rounded-2xl neon-glow border border-neon-border space-y-6">
        <div class="text-center space-y-2">
          <div class="w-12 h-12 bg-neon-blue/10 border border-neon-blue rounded-full flex items-center justify-center mx-auto text-neon-blue text-xl neon-glow">
            <i class="fa-solid fa-user-shield"></i>
          </div>
          <h2 class="font-orbitron text-2xl font-bold text-white">Admin Login</h2>
          <p class="text-slate-400 text-xs">Masukkan kredensial admin Rovcell</p>
        </div>
        <form id="loginForm" onsubmit="handleAdminLogin(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Username</label>
            <input type="text" id="adminUser" required class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-neon-blue">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-300 mb-1">Password</label>
            <input type="password" id="adminPass" required class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-neon-blue">
          </div>
          <button type="submit" class="w-full bg-neon-blue text-neon-dark font-bold py-3 rounded-xl hover:bg-cyan-400 transition shadow-lg shadow-cyan-500/20 cursor-pointer">
            Masuk Dashboard
          </button>
        </form>
      </div>
    </section>

    <!-- SECTION: ADMIN DASHBOARD -->
    <section id="tab-admin" class="hidden space-y-6">
      <!-- Header Admin -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-neon-card p-6 rounded-2xl border border-neon-border neon-glow">
        <div>
          <h2 class="font-orbitron text-2xl font-bold text-white">Admin Dashboard</h2>
          <p class="text-[11px] text-slate-400">Kelola data service, bagi hasil teknisi 40%, cetak nota thermal &amp; pengaturan WA.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <button type="button" onclick="openAdminProfileModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm rounded-xl border border-slate-700 transition cursor-pointer">
            <i class="fa-solid fa-user-gear mr-2 text-neon-blue"></i>Edit Profil Admin
          </button>
          <button type="button" onclick="handleLogout()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm rounded-xl border border-slate-700 transition cursor-pointer">
            <i class="fa-solid fa-right-from-bracket mr-2"></i>Keluar
          </button>
        </div>
      </div>

      <!-- Navigasi 3 Sub-Menu Admin -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 bg-neon-card p-2 rounded-2xl border border-neon-border">
        <button type="button" id="subTabBtn-input" onclick="switchAdminSubTab('input')" class="px-4 py-3 rounded-xl font-orbitron text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 bg-neon-blue text-neon-dark shadow-lg shadow-cyan-500/20 cursor-pointer">
          <i class="fa-solid fa-plus-circle"></i> Input Service
        </button>
        <button type="button" id="subTabBtn-list" onclick="switchAdminSubTab('list')" class="px-4 py-3 rounded-xl font-orbitron text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 text-slate-300 hover:bg-slate-800/80 cursor-pointer">
          <i class="fa-solid fa-list-check"></i> Daftar Service Pelanggan
          <span id="badgeTotalServices" class="px-2 py-0.5 text-[10px] rounded-full bg-neon-blue/20 text-neon-blue border border-neon-blue/40">0</span>
        </button>
        <button type="button" id="subTabBtn-finance" onclick="switchAdminSubTab('finance')" class="px-4 py-3 rounded-xl font-orbitron text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 text-slate-300 hover:bg-slate-800/80 cursor-pointer">
          <i class="fa-solid fa-chart-line"></i> Laporan Keuangan &amp; Teknisi
        </button>
      </div>

      <!-- SUB-TAB 1: INPUT SERVICE -->
      <div id="adminSubTab-input" class="space-y-6">
        <div class="bg-neon-card p-6 rounded-2xl border border-neon-border neon-glow space-y-6">
          <div class="flex justify-between items-center border-b border-slate-800 pb-4">
            <h3 id="formTitle" class="font-orbitron text-lg font-bold text-white"><i class="fa-solid fa-plus-circle mr-2 text-neon-blue"></i>Tambah Service Baru</h3>
            <button type="button" id="cancelEditBtn" onclick="resetServiceForm()" class="hidden text-xs text-red-400 hover:text-red-300 font-semibold underline cursor-pointer">Batalkan Edit</button>
          </div>

          <form id="serviceForm" onsubmit="saveServiceData(event)" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="space-y-1">
              <label class="block text-xs font-medium text-slate-300">Nomor Nota</label>
              <input type="text" id="inputNota" readonly class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-2.5 text-neon-blue font-bold text-sm">
            </div>
            <div class="space-y-1">
              <label class="block text-xs font-medium text-slate-300">Nama Pelanggan</label>
              <input type="text" id="inputNama" required placeholder="Nama Pelanggan" class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-neon-blue">
            </div>
            <div class="space-y-1">
              <label class="block text-xs font-medium text-slate-300">No. WhatsApp</label>
              <input type="text" id="inputPhone" required placeholder="08xxxxxxxxxx" class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-neon-blue">
            </div>
            <div class="space-y-1">
              <label class="block text-xs font-medium text-slate-300">Merk / Type HP</label>
              <input type="text" id="inputMerk" required placeholder="Samsung A52" class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-neon-blue">
            </div>
            <div class="space-y-1">
              <label class="block text-xs font-medium text-slate-300">Kerusakan</label>
              <input type="text" id="inputKerusakan" required placeholder="Ganti LCD" class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-neon-blue">
            </div>
            <div class="space-y-1">
              <label class="block text-xs font-medium text-slate-300">Harga Modal (Rp)</label>
              <input type="number" id="inputModal" oninput="updateLiveFormSplit()" required placeholder="0" class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-neon-blue">
            </div>
            <div class="space-y-1">
              <label class="block text-xs font-medium text-slate-300">Biaya Service / Jual (Rp)</label>
              <input type="number" id="inputBiaya" oninput="updateLiveFormSplit()" required placeholder="0" class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-neon-blue">
            </div>
            <div class="space-y-1 md:col-span-2 flex items-end">
              <div class="w-full bg-neon-dark/90 border border-neon-border rounded-xl px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 text-xs">
                <div>
                  <span class="text-slate-400">Laba Bersih:</span>
                  <span id="liveNetProfit" class="font-orbitron font-bold text-emerald-400 ml-1">Rp 0</span>
                </div>
                <div>
                  <span class="text-slate-400">Teknisi (40%):</span>
                  <span id="liveTechShare" class="font-orbitron font-bold text-amber-400 ml-1">Rp 0</span>
                </div>
                <div>
                  <span class="text-slate-400">Toko (60%):</span>
                  <span id="liveShopShare" class="font-orbitron font-bold text-cyan-400 ml-1">Rp 0</span>
                </div>
              </div>
            </div>
            <div class="space-y-1 md:col-span-2 lg:col-span-3 flex items-center pt-1">
              <label class="flex items-center space-x-3 bg-neon-dark border border-neon-border px-4 py-3 rounded-xl cursor-pointer hover:border-neon-blue w-full">
                <input type="checkbox" id="inputLunas" class="w-4 h-4 text-neon-blue rounded focus:ring-0 bg-neon-dark border-neon-border">
                <span class="text-xs font-semibold text-white"><i class="fa-solid fa-circle-check text-emerald-400 mr-1.5"></i>Status Pembayaran Lunas (Sudah Lunas)</span>
              </label>
            </div>
            <div class="space-y-1 md:col-span-2 lg:col-span-3">
              <label class="block text-xs font-medium text-slate-300 mb-2">Status Perbaikan</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-7 gap-2" id="statusOptions">
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputStatus" value="Menunggu Pengecekan" checked class="text-neon-blue focus:ring-0">
                  <span>Menunggu Pengecekan</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputStatus" value="Sedang Dikerjakan" class="text-neon-blue focus:ring-0">
                  <span>Sedang Dikerjakan</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputStatus" value="Menunggu Sparepart" class="text-neon-blue focus:ring-0">
                  <span>Menunggu Sparepart</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputStatus" value="Selesai" class="text-neon-blue focus:ring-0">
                  <span>Selesai</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputStatus" value="Diambil" class="text-neon-blue focus:ring-0">
                  <span>Diambil</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-red-500/40 p-2.5 rounded-xl cursor-pointer hover:border-red-500 text-xs">
                  <input type="radio" name="inputStatus" value="Dibatalkan (Belum Diambil)" class="text-red-500 focus:ring-0">
                  <span class="text-red-400">Batal (Belum Diambil)</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-red-500/40 p-2.5 rounded-xl cursor-pointer hover:border-red-500 text-xs">
                  <input type="radio" name="inputStatus" value="Dibatalkan (Sudah Diambil)" class="text-red-500 focus:ring-0">
                  <span class="text-red-400">Batal (Sudah Diambil)</span>
                </label>
              </div>
            </div>
            <div class="space-y-1 md:col-span-2 lg:col-span-3">
              <label class="block text-xs font-medium text-slate-300 mb-2">Pilihan Garansi (Aktif saat status "Diambil")</label>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2" id="garansiOptions">
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputGaransi" value="Tidak ada" class="text-neon-blue focus:ring-0">
                  <span>Tidak ada</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputGaransi" value="1 minggu" class="text-neon-blue focus:ring-0">
                  <span>1 Minggu</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputGaransi" value="1 bulan" checked class="text-neon-blue focus:ring-0">
                  <span>1 Bulan</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputGaransi" value="3 bulan" class="text-neon-blue focus:ring-0">
                  <span>3 Bulan</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputGaransi" value="6 bulan" class="text-neon-blue focus:ring-0">
                  <span>6 Bulan</span>
                </label>
                <label class="flex items-center space-x-2 bg-neon-dark border border-neon-border p-2.5 rounded-xl cursor-pointer hover:border-neon-blue text-xs">
                  <input type="radio" name="inputGaransi" value="1 tahun" class="text-neon-blue focus:ring-0">
                  <span>1 Tahun</span>
                </label>
              </div>
            </div>
            <div class="md:col-span-2 lg:col-span-3 space-y-1">
              <label class="block text-xs font-medium text-slate-300">Keterangan Perbaikan</label>
              <textarea id="inputKeterangan" rows="2" placeholder="Detail pengerjaan..." class="w-full bg-neon-dark border border-neon-border rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-neon-blue"></textarea>
            </div>
            <div class="md:col-span-2 lg:col-span-3 flex justify-end gap-3 pt-2">
              <button type="button" onclick="switchAdminSubTab('list')" class="px-5 py-3 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold rounded-xl text-sm transition cursor-pointer">
                Lihat Daftar Service
              </button>
              <button type="submit" class="bg-neon-blue text-neon-dark font-bold px-6 py-3 rounded-xl hover:bg-cyan-400 transition shadow-lg shadow-cyan-500/20 text-sm cursor-pointer">
                <i class="fa-solid fa-save mr-2"></i>Simpan Data Service
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- SUB-TAB 2: DAFTAR SERVICE PELANGGAN -->
      <div id="adminSubTab-list" class="hidden space-y-6">
        <div class="bg-neon-card p-6 rounded-2xl border border-neon-border neon-glow space-y-4">
          <div class="flex flex-col gap-4 border-b border-slate-800 pb-4">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
