    async function saveServiceData(e) {
      e.preventDefault();
      const nota = document.getElementById('inputNota').value;
      const nama = document.getElementById('inputNama').value;
      const phone = document.getElementById('inputPhone').value;
      const merk = document.getElementById('inputMerk').value;
      const kerusakan = document.getElementById('inputKerusakan').value;
      const modal = parseFloat(document.getElementById('inputModal').value) || 0;
      const biaya = parseFloat(document.getElementById('inputBiaya').value) || 0;

      const statusEl = document.querySelector('input[name="inputStatus"]:checked');
      const status = statusEl ? statusEl.value : 'Menunggu Pengecekan';

      const isPaid = isStatusCancelled(status) ? false : document.getElementById('inputLunas').checked;

      const garansiEl = document.querySelector('input[name="inputGaransi"]:checked');
      const garansi = garansiEl ? garansiEl.value : 'Tidak ada';
      const keterangan = document.getElementById('inputKeterangan').value;

      let existingItem = serviceList.find(s => s.nota === nota);
      let date = existingItem && existingItem.date ? existingItem.date : new Date().toISOString().split('T')[0];

      let keluarDate = existingItem && existingItem.keluarDate ? existingItem.keluarDate : null;
      if ((status === 'Diambil' || status === 'Dibatalkan (Sudah Diambil)') && !keluarDate) {
        keluarDate = new Date().toISOString().split('T')[0];
      } else if (status !== 'Diambil' && status !== 'Dibatalkan (Sudah Diambil)') {
        keluarDate = null;
      }

      let diambilDate = (status === 'Diambil') ? keluarDate : null;

      const newData = { nota, nama, phone, merk, kerusakan, modal, biaya, isPaid, status, garansi, keterangan, date, diambilDate, keluarDate };
      try {
        if (window.db && window.setDoc && window.doc) {
          await window.setDoc(window.doc(window.db, "services", nota), newData);
        }

        let index = serviceList.findIndex(s => s.nota === nota);
        if (index !== -1) {
          serviceList[index] = newData;
        } else {
          serviceList.unshift(newData);
        }
        localStorage.setItem('rovcell_cached_services', JSON.stringify(serviceList));

        const badgeEl = document.getElementById('badgeTotalServices');
        if (badgeEl) badgeEl.innerText = serviceList.length;

        showCustomAlert("Data service berhasil disimpan!", true);
        resetServiceForm();
        switchAdminSubTab('list');
      } catch (err) {
        console.error(err);
        showCustomAlert("Gagal menyimpan data.");
      }
    }

