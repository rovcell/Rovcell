          appSettings = { ...appSettings, ...JSON.parse(savedLocal) };
        }
        if (window.db && window.doc && window.getDoc) {
          const docRef = window.doc(window.db, "settings", "appConfig");
          const docSnap = await window.getDoc(docRef);
          if (docSnap.exists()) {
            appSettings = { ...appSettings, ...docSnap.data() };
            localStorage.setItem('rovcell_app_settings', JSON.stringify(appSettings));
          }
        }
      } catch (e) {
        console.error("Gagal memuat pengaturan aplikasi:", e);
      }
    }

    function loadServicesFromDB() {
      try {
        if (!window.db || !window.onSnapshot || !window.collection) return;
        window.onSnapshot(window.collection(window.db, "services"), (querySnapshot) => {
          serviceList = [];
          querySnapshot.forEach((docSnap) => {
            serviceList.push({ id: docSnap.id, ...docSnap.data() });
          });
          serviceList.sort((a, b) => (b.nota || '').localeCompare(a.nota || ''));
          localStorage.setItem('rovcell_cached_services', JSON.stringify(serviceList));

          const badgeEl = document.getElementById('badgeTotalServices');
