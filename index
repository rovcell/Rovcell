    function notifyCustomerWhatsApp(nota) {
      const item = serviceList.find(s => s.nota === nota);
      if (!item || !item.phone) {
        showCustomAlert("Nomor WhatsApp pelanggan tidak valid atau kosong!");
        return;
      }
      const cancelled = isStatusCancelled(item.status);
      let paidStatusText = cancelled ? "Dibatalkan" : (item.isPaid ? "Sudah Lunas" : "Belum Lunas");
      let cleanPhone = item.phone.replace(/[^0-9]/g, '');
      let pin3 = cleanPhone.slice(-3) || '-';
      let tpl = appSettings.waTemplate || DEFAULT_WA_TEMPLATE;

      let text = tpl
        .replace(/\{nama\}/g, item.nama || '')
        .replace(/\{nota\}/g, item.nota || '')
        .replace(/\{pin\}/g, pin3)
        .replace(/\{merk\}/g, item.merk || '')
        .replace(/\{kerusakan\}/g, item.kerusakan || '')
        .replace(/\{status\}/g, item.status || '')
        .replace(/\{keterangan\}/g, item.keterangan || 'Dalam proses')
        .replace(/\{pembayaran\}/g, paidStatusText)
        .replace(/\{biaya\}/g, (item.biaya || 0).toLocaleString('id-ID'))
        .replace(/\{garansi\}/g, item.garansi || 'Tidak ada');

      let phoneTarget = cleanPhone;
      if (phoneTarget.startsWith('0')) phoneTarget = '62' + phoneTarget.substring(1);
      window.open(`https://wa.me/${phoneTarget}?text=${encodeURIComponent(text)}`, '_blank');
    }

    function saveRecentSearch(nota, pin, nama, merk) {
      let history = JSON.parse(localStorage.getItem('rovcell_recent_searches') || '[]');
      history = history.filter(item => item.nota !== nota);
      history.unshift({ nota, pin, nama, merk, timestamp: new Date().toLocaleDateString('id-ID') });
      if (history.length > 5) history.pop();
      localStorage.setItem('rovcell_recent_searches', JSON.stringify(history));
      renderRecentSearches();
    }

    function renderRecentSearches() {
      let history = JSON.parse(localStorage.getItem('rovcell_recent_searches') || '[]');
      const container = document.getElementById('recentSearchesContainer');
      const chipsList = document.getElementById('recentChipsList');
      if (!container || !chipsList) return;

      if (history.length === 0) {
        container.classList.add('hidden');
        return;
      }

      container.classList.remove('hidden');
      chipsList.innerHTML = '';

      history.forEach(item => {
        chipsList.innerHTML += `
          <button type="button" onclick="fillSearchForm('${item.nota}', '${item.pin}')" class="px-3 py-1.5 bg-neon-dark hover:bg-neon-blue/10 border border-neon-border hover:border-neon-blue rounded-xl text-xs flex items-center gap-2 transition text-left group cursor-pointer">
            <div>
              <span class="font-orbitron font-bold text-neon-blue">${item.nota}</span>
              <span class="text-slate-400 text-[10px] ml-1">(${item.merk || item.nama})</span>
            </div>
            <i class="fa-solid fa-arrow-right text-[10px] text-slate-500 group-hover:text-neon-blue"></i>
          </button>
        `;
      });
    }

    function fillSearchForm(nota, pin) {
      let cleanNota = nota.replace('ROV-', '');
      document.getElementById('searchNotaInput').value = cleanNota;
      document.getElementById('searchPhonePin').value = pin;
      searchService();
    }

    function clearRecentSearches() {
      localStorage.removeItem('rovcell_recent_searches');
      renderRecentSearches();
    }

    async function quickUpdateStatus(nota, newStatus) {
      const item = serviceList.find(s => s.nota === nota);
      if (!item) return;

      let date = new Date().toISOString().split('T')[0];
      let keluarDate = item.keluarDate || null;
      if ((newStatus === 'Diambil' || newStatus === 'Dibatalkan (Sudah Diambil)') && !keluarDate) {
        keluarDate = date;
      } else if (newStatus !== 'Diambil' && newStatus !== 'Dibatalkan (Sudah Diambil)') {
        keluarDate = null;
      }
      let diambilDate = (newStatus === 'Diambil') ? keluarDate : null;
      let isPaid = isStatusCancelled(newStatus) ? false : item.isPaid;

      const updatedData = { ...item, status: newStatus, isPaid, diambilDate, keluarDate };
      try {
        if (window.db && window.setDoc && window.doc) {
          await window.setDoc(window.doc(window.db, "services", nota), updatedData);
        }
        item.status = newStatus;
        item.isPaid = isPaid;
        item.diambilDate = diambilDate;
        item.keluarDate = keluarDate;
        localStorage.setItem('rovcell_cached_services', JSON.stringify(serviceList));
        renderAdminTable();
        updateFinancialStats();
      } catch (err) {
        console.error(err);
        showCustomAlert("Gagal memperbarui status secara cepat.");
      }
    }

    function openLupaNotaModal() {
      document.getElementById('lupaNotaModal').classList.remove('hidden');
      document.getElementById('lupaPhoneInput').value = '';
      document.getElementById('lupaNotaResultContainer').innerHTML = '';
      document.getElementById('lupaNotaResultContainer').classList.add('hidden');
    }

    function closeLupaNotaModal() {
      document.getElementById('lupaNotaModal').classList.add('hidden');
    }

    function executeLupaNotaSearch() {
      let phoneQuery = document.getElementById('lupaPhoneInput').value.trim();
      const resultContainer = document.getElementById('lupaNotaResultContainer');
      resultContainer.classList.remove('hidden');
      resultContainer.innerHTML = '';

      if (!phoneQuery) {
        resultContainer.innerHTML = `<p class="text-xs text-red-400 text-center py-2">Masukkan nomor WhatsApp terlebih dahulu.</p>`;
        return;
      }

      let cleanQuery = phoneQuery.replace(/[^0-9]/g, '');
      if (cleanQuery.startsWith('0')) cleanQuery = '62' + cleanQuery.substring(1);

      let matches = serviceList.filter(s => {
        let itemPhone = (s.phone || '').replace(/[^0-9]/g, '');
        if (itemPhone.startsWith('0')) itemPhone = '62' + itemPhone.substring(1);
        return itemPhone && (itemPhone.includes(cleanQuery) || cleanQuery.includes(itemPhone));
      });

      if (matches.length === 0) {
        resultContainer.innerHTML = `<p class="text-[11px] text-slate-400 text-center py-2">Tidak ditemukan data service dengan nomor WhatsApp tersebut.</p>`;
        return;
      }

      resultContainer.innerHTML = `<p class="text-xs font-medium text-neon-blue mb-1">Ditemukan ${matches.length} nota:</p>`;
      matches.forEach(m => {
        let last3 = (m.phone || '').replace(/[^0-9]/g, '').slice(-3);
        resultContainer.innerHTML += `
          <div class="p-3 bg-neon-dark rounded-xl border border-neon-border/60 flex justify-between items-center text-xs">
            <div>
              <span class="font-orbitron font-bold text-neon-blue text-sm">${m.nota}</span>
              <div class="text-slate-300 font-medium mt-0.5">${m.merk} (${m.kerusakan})</div>
              <div class="text-slate-400 text-[11px] mt-0.5"><i class="fa-regular fa-calendar mr-1"></i>Masuk: ${m.date || '-'}</div>
            </div>
            <button type="button" onclick="selectNotaFromLupa('${m.nota}', '${last3}')" class="px-3 py-2 bg-neon-blue/10 hover:bg-neon-blue hover:text-neon-dark border border-neon-blue text-neon-blue rounded-lg transition font-bold cursor-pointer">
              Pilih
            </button>
          </div>
        `;
      });
    }

    function selectNotaFromLupa(nota, last3Pin) {
      let cleanNota = nota.replace('ROV-', '');
      document.getElementById('searchNotaInput').value = cleanNota;
      document.getElementById('searchPhonePin').value = last3Pin;
      closeLupaNotaModal();
      searchService();
    }

    window.addEventListener('DOMContentLoaded', () => {
      initAppData();
    });
  </script>
</body>
</html>