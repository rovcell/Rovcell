            <div>UNIT HP : ${item.merk}</div>
            <div>KELUHAN : ${item.kerusakan}</div>
            <div>STATUS  : ${item.status}</div>
            ${item.keterangan ? `<div>KET     : ${item.keterangan}</div>` : ''}
