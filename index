    async function quickTogglePaid(nota, isPaidVal) {
      const item = serviceList.find(s => s.nota === nota);
      if (!item || isStatusCancelled(item.status)) return;
      const updatedData = { ...item, isPaid: isPaidVal };
      try {
        if (window.db && window.setDoc && window.doc) {
          await window.setDoc(window.doc(window.db, "services", nota), updatedData);
        }
        item.isPaid = isPaidVal;
        localStorage.setItem('rovcell_cached_services', JSON.stringify(serviceList));
        renderAdminTable();
        updateFinancialStats();
      } catch (err) {
        console.error(err);
        showCustomAlert("Gagal memperbarui status pembayaran.");
      }
    }

    function updateFinancialStats() {
      const todayStr = new Date().toISOString().split('T')[0];
      const dateInputEl = document.getElementById('filterDateInput');
      const selectedDate = (dateInputEl && dateInputEl.value) ? dateInputEl.value : todayStr;
      const monthInputEl = document.getElementById('filterMonthInput');
      const monthInputVal = (monthInputEl && monthInputEl.value) ? monthInputEl.value : todayStr.slice(0, 7);

      const periodFilterEl = document.getElementById('techReportPeriodFilter');
      const periodFilter = periodFilterEl ? periodFilterEl.value : 'month';
      const statusFilterEl = document.getElementById('techReportStatusFilter');
      const statusFilter = statusFilterEl ? statusFilterEl.value : 'all';

      const dailyHeaderLabel = document.getElementById('dailySummaryHeaderLabel');
      if (dailyHeaderLabel) {
        dailyHeaderLabel.innerHTML = `<i class="fa-solid fa-calendar-day mr-1.5"></i>Harian (${selectedDate})`;
      }

      let dailyProfit = 0, dailyModal = 0, dailyGross = 0, dailyTech = 0, dailyShop = 0;
      let monthlyProfit = 0, monthlyModal = 0, monthlyGross = 0, monthlyTech = 0, monthlyShop = 0;

      const techTbody = document.getElementById('techReportTableBody');
      const techTfoot = document.getElementById('techReportTableFoot');
      if (techTbody) techTbody.innerHTML = '';

      let reportTotalNet = 0, reportTotalTech = 0, reportTotalShop = 0, reportCount = 0;

      serviceList.forEach(s => {
        if (isStatusCancelled(s.status)) return;

        let modal = s.modal || 0;
        let biaya = s.biaya || 0;
        let profit = biaya - modal;
        let techPart = profit > 0 ? Math.round(profit * 0.40) : 0;
        let shopPart = profit > 0 ? (profit - techPart) : profit;
        let itemDate = s.date || '';

        if (itemDate === selectedDate) {
          dailyProfit += profit;
          dailyModal += modal;
          dailyGross += biaya;
          dailyTech += techPart;
          dailyShop += shopPart;
        }

        if (monthInputVal && itemDate.startsWith(monthInputVal)) {
          monthlyProfit += profit;
          monthlyModal += modal;
          monthlyGross += biaya;
          monthlyTech += techPart;
          monthlyShop += shopPart;
        }

        let matchesPeriod = false;
        if (periodFilter === 'all') matchesPeriod = true;
        else if (periodFilter === 'day') matchesPeriod = (itemDate === selectedDate);
        else matchesPeriod = (monthInputVal && itemDate.startsWith(monthInputVal));

        if (matchesPeriod && (statusFilter === 'all' || (statusFilter === 'paid' && s.isPaid))) {
          reportCount++;
          reportTotalNet += profit;
          reportTotalTech += techPart;
          reportTotalShop += shopPart;
          if (techTbody) {
            techTbody.innerHTML += `
              <tr class="hover:bg-slate-800/40">
                <td class="py-2 px-3 text-slate-300">${s.date || '-'}</td>
                <td class="py-2 px-3 font-orbitron font-bold text-neon-blue">${s.nota}</td>
                <td class="py-2 px-3 text-slate-200">${s.nama} <span class="text-slate-400">(${s.merk})</span> ${s.isPaid ? '<span class="text-[10px] text-emerald-400 font-bold ml-1">[LUNAS]</span>' : '<span class="text-[10px] text-red-400 ml-1">[BELUM]</span>'}</td>
                <td class="py-2 px-3 text-right font-semibold text-emerald-400">Rp ${profit.toLocaleString('id-ID')}</td>
                <td class="py-2 px-3 text-right font-bold text-amber-400">Rp ${techPart.toLocaleString('id-ID')}</td>
                <td class="py-2 px-3 text-right font-semibold text-cyan-300">Rp ${shopPart.toLocaleString('id-ID')}</td>
              </tr>
            `;
          }
        }
      });

      if (techTbody && reportCount === 0) {
        techTbody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-slate-500">Tidak ada transaksi service aktif pada periode filter terpilih.</td></tr>`;
      }

      if (techTfoot) {
        techTfoot.innerHTML = `
          <tr>
            <td colspan="3" class="py-2.5 px-3 text-slate-200">TOTAL (${reportCount} Transaksi)</td>
            <td class="py-2.5 px-3 text-right text-emerald-400">Rp ${reportTotalNet.toLocaleString('id-ID')}</td>
            <td class="py-2.5 px-3 text-right text-amber-400">Rp ${reportTotalTech.toLocaleString('id-ID')}</td>
            <td class="py-2.5 px-3 text-right text-cyan-300">Rp ${reportTotalShop.toLocaleString('id-ID')}</td>
          </tr>
        `;
      }

      const setTxt = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.innerText = `Rp ${val.toLocaleString('id-ID')}`;
      };

      setTxt('statDailyProfit', dailyProfit);
      setTxt('statDailyModal', dailyModal);
      setTxt('statDailyGross', dailyGross);
      setTxt('statDailyTech', dailyTech);
      setTxt('statDailyShop', dailyShop);

      setTxt('statMonthlyProfit', monthlyProfit);
      setTxt('statMonthlyModal', monthlyModal);
      setTxt('statMonthlyGross', monthlyGross);
      setTxt('statMonthlyTech', monthlyTech);
      setTxt('statMonthlyShop', monthlyShop);
    }

