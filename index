            let num = parseInt(parts[1]);
            if (!isNaN(num) && num > maxNum) maxNum = num;
          }
        });
        nextNum = maxNum + 1;
      }
      let notaStr = 'ROV-' + String(nextNum).padStart(4, '0');
      const notaEl = document.getElementById('inputNota');
      if (notaEl) notaEl.value = notaStr;
