    function getProgressBarHtml(currentStatus) {
      if (isStatusCancelled(currentStatus)) {
        return `
          <div class="py-4 px-4 bg-red-500/10 rounded-2xl border border-red-500/30 my-2 text-center space-y-2">
            <div class="w-12 h-12 bg-red-500/20 border border-red-500/40 rounded-full flex items-center justify-center mx-auto text-red-400 text-xl">
              <i class="fa-solid fa-ban"></i>
            </div>
            <div class="font-orbitron font-bold text-red-400 text-base">Service Dibatalkan</div>
            <p class="text-[11px] text-slate-400">Proses perbaikan untuk unit ini telah dibatalkan.</p>
          </div>
        `;
      }

      const steps = [
        { name: 'Menunggu Pengecekan', label: 'Pengecekan', icon: 'fa-clipboard-question' },
        { name: 'Sedang Dikerjakan', label: 'Perbaikan', icon: 'fa-screwdriver-wrench' },
        { name: 'Selesai', label: 'Selesai', icon: 'fa-circle-check' },
        { name: 'Diambil', label: 'Diambil', icon: 'fa-bag-shopping' }
      ];

      let activeIdx = 0;
      if (currentStatus === 'Menunggu Pengecekan') activeIdx = 0;
      else if (currentStatus === 'Sedang Dikerjakan' || currentStatus === 'Menunggu Sparepart') activeIdx = 1;
      else if (currentStatus === 'Selesai') activeIdx = 2;
      else if (currentStatus === 'Diambil') activeIdx = 3;

      let html = '<div class="py-4 px-2 bg-neon-dark/60 rounded-2xl border border-neon-border/60 my-2"><div class="flex items-center justify-between relative max-w-md mx-auto px-4">';
      html += '<div class="absolute left-10 right-10 top-5 h-1 bg-slate-800 -z-0"></div>';

      steps.forEach((step, idx) => {
        let isCompleted = idx <= activeIdx;
        let isCurrent = idx === activeIdx;

        let circleClass = isCompleted ? 'bg-neon-blue text-neon-dark neon-glow border-neon-blue scale-110 shadow-lg shadow-cyan-500/50' : 'bg-slate-900 text-slate-500 border-slate-700';
        if (isCurrent) circleClass += ' ring-4 ring-neon-blue/40 font-black animate-pulse';

        html += `
          <div class="flex flex-col items-center relative z-10 space-y-2">
            <div class="w-10 h-10 rounded-xl border-2 flex items-center justify-center font-bold text-sm transition-all duration-300 ${circleClass}">
              <i class="fa-solid ${step.icon}"></i>
            </div>
            <span class="text-[11px] font-semibold tracking-wide text-center ${isCurrent ? 'text-neon-blue font-bold bg-neon-blue/10 px-2 py-0.5 rounded-md border border-neon-blue/40 shadow' : (isCompleted ? 'text-slate-200' : 'text-slate-500')}">${step.label}</span>
          </div>
        `;
      });

      html += '</div></div>';
      return html;
    }

